OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender for rep login codes. The web app has no inbound call to reply from.
# Set this to the sparring number, e.g. +18883946860
TWILIO_SMS_FROM=
DATABASE_URL=postgresql://s2s_user:PASSWORD@localhost:5432/s2s_dev
TEST_DATABASE_URL=postgresql://s2s_user:PASSWORD@localhost:5432/s2s_test
DEEPGRAM_API_KEY=
# Signs the web session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=
